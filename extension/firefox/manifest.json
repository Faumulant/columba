{
  "manifest_version": 3,
  "name": "Columba",
  "version": "1.2.0",
  "description": "选中网页里的东西，右键发送到你的设备。需要 Columba 后台运行。",
  "permissions": ["contextMenus", "nativeMessaging"],
  "background": { "scripts": ["background.js"] },
  "action": {
    "default_title": "Columba",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": { "id": "drop@drop.local", "strict_min_version": "109.0" }
  }
}
